{
  "manifest_version": 3,
  "name": "Bullshit Blocker",
  "version": "1.3.0",
  "description": "Blocks unwanted YouTube channels.",
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "blocked-channel.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}